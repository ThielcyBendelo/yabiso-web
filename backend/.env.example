# YaBiso Platform - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ========================
# Application Environment
# ========================
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# ========================
# API Gateway
# ========================
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# ========================
# Authentication
# ========================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
JWT_REFRESH_EXPIRE_DAYS=7

# ========================
# Database Connections
# ========================
# SQL Server (Auth Service)
SQLSERVER_URL=mssql+pyodbc://SA:YaBiso@Secure2026!@sqlserver:1433/YaBiso?driver=ODBC+Driver+17+for+SQL+Server
SQLSERVER_PASSWORD=YaBiso@Secure2026!

# MySQL (Products & Payments Services)
MYSQL_URL=mysql+pymysql://yabiso_user:YaBiso@Pass2026!@mysql:3306/yabiso_products
MYSQL_ROOT_PASSWORD=YaBiso@Root2026!
MYSQL_USER=yabiso_user
MYSQL_PASSWORD=YaBiso@Pass2026!

# MongoDB (Analytics Service)
MONGODB_URL=mongodb://yabiso_admin:YaBiso@Mongo2026!@mongodb:27017/?authSource=admin
MONGODB_DB=yabiso_analytics
MONGO_ROOT_USER=yabiso_admin
MONGO_ROOT_PASSWORD=YaBiso@Mongo2026!

# Redis (Cache)
REDIS_URL=redis://:YaBiso@Redis2026!@redis:6379/0
REDIS_PASSWORD=YaBiso@Redis2026!

# RabbitMQ (Message Queue)
RABBITMQ_URL=amqp://yabiso_user:YaBiso@RabbitMQ2026!@rabbitmq:5672/
RABBITMQ_USER=yabiso_user
RABBITMQ_PASSWORD=YaBiso@RabbitMQ2026!

# ========================
# Payment Providers
# ========================
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# Mobile Money Providers
MOBILE_MONEY_API_KEY=your_mobile_money_api_key
MOBILE_MONEY_SECRET=your_mobile_money_secret

# ========================
# Email Configuration
# ========================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@yabiso.com

# ========================
# AWS/Storage Configuration
# ========================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=yabiso-products
AWS_S3_REGION=us-east-1

# ========================
# CORS & Security
# ========================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com
ALLOWED_HOSTS=localhost,yourdomain.com

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ========================
# Service URLs (for Docker Compose)
# ========================
AUTH_SERVICE_URL=http://auth-service:8001
PRODUCTS_SERVICE_URL=http://products-service:8002
PAYMENTS_SERVICE_URL=http://payments-service:8003
ANALYTICS_SERVICE_URL=http://analytics-service:8004

# ========================
# Third-party Services
# ========================
SENTRY_DSN=your_sentry_dsn_for_error_tracking
DATADOG_API_KEY=your_datadog_api_key

# ========================
# Logging
# ========================
LOG_FORMAT=json
LOG_LEVEL=INFO


#1. Espace Public & Acheteurs
# Page d'Accueil (Home)
#	Bannière héro (Mise en avant du "Made in DRC").
o	Barre de recherche rapide (Produit, Fournisseur, Ville).
o	Filtrage rapide par Provinces (Kinshasa, Kongo Central, Kivu, Lualaba, etc.).
o	Carrousel des produits vedettes du mois.
•	Catalogue des Produits
o	Grille de cartes produits (comme la ProductCard vue précédemment).
o	Filtres avancés : Catégorie (Agriculture, Artisanat, Cosmétique), Fourchette de prix (USD/CDF), Province d'origine.
•	Détail du Produit
o	Photos haute définition (compressées pour le réseau mobile).
o	Description, fiches techniques, et quantité minimale de commande (pour les grossistes).
o	Bouton d'action principal : "Discuter sur WhatsApp" ou "Appeler le fournisseur".
•	Annuaire des Fournisseurs
o	Liste de toutes les coopératives, PME et artisans inscrits.
o	Profil public du fournisseur avec son histoire, sa localisation et tous ses produits.

