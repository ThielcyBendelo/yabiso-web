# ========== CONFIGURATION FRONTEND (Vite - toutes les variables commencent par VITE_) ==========
VITE_API_URL=http://localhost:8000
VITE_API_GATEWAY=http://localhost:8000
VITE_CINETPAY_SITE_ID=VOTRE_SITE_ID_ICI
VITE_CINETPAY_API_KEY=VOTRE_API_KEY_ICI
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_ENVIRONMENT=development


# ========== CONFIGURATION GÉNÉRALE ==========
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# ========== PYTHON & UVICORN ==========
PYTHONUNBUFFERED=1
WORKERS=4
RELOAD=True

# ========== SERVICES URLS (Docker) ==========
AUTH_SERVICE_URL=http://auth-service:8001
PRODUCTS_SERVICE_URL=http://products-service:8002
PAYMENTS_SERVICE_URL=http://payments-service:8003
ANALYTICS_SERVICE_URL=http://analytics-service:8004
API_GATEWAY_URL=http://api-gateway:8000

# ========== JWT & AUTHENTIFICATION ==========
JWT_SECRET_KEY=YA_BISO_CONGO_SECRET_KEY_SUPER_SECURE_2026_min_32_chars_for_production!
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7
JWT_ENABLE_BLACKLIST=True

# ========== MFA & SÉCURITÉ ==========
MFA_ENABLED=True
MFA_ISSUER=YaBiso-RDC
TOTP_WINDOW=1
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_NUMBERS=True
PASSWORD_REQUIRE_SPECIAL=True

# ========== RATE LIMITING ==========
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# ========== CORS & SÉCURITÉ ==========
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174,https://yabiso.vercel.app,https://yabiso.cd
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Request-ID

# ========== COOKIES ==========
COOKIE_SECURE=False
COOKIE_HTTPONLY=True
COOKIE_SAMESITE=Lax
COOKIE_MAX_AGE=2592000

# ========== BASES DE DONNÉES ==========
# SQL Server (Auth Service)
SQLSERVER_HOST=sqlserver
SQLSERVER_PORT=1433
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YaBiso@2024Secure!
SQLSERVER_DATABASE=yabiso_auth
SQLSERVER_URL=mssql+pyodbc://sa:YaBiso@2024Secure!@sqlserver:1433/yabiso_auth?driver=ODBC+Driver+17+for+SQL+Server

# MySQL (Products Service)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=yabiso_user
MYSQL_PASSWORD=YaBiso@2024MySQL!
MYSQL_DATABASE=yabiso_products
MYSQL_URL=mysql+pymysql://yabiso_user:YaBiso@2024MySQL!@mysql:3306/yabiso_products

# MongoDB (Analytics Service)
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USER=yabiso_admin
MONGODB_PASSWORD=YaBiso@2024Mongo!
MONGODB_DATABASE=yabiso_analytics
MONGODB_URL=mongodb://yabiso_admin:YaBiso@2024Mongo!@mongodb:27017/yabiso_analytics?authSource=admin
MONGO_URI=mongodb://yabiso_admin:YaBiso@2024Mongo!@mongodb:27017/yabiso_analytics?authSource=admin

# Redis (Cache & Sessions)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YaBiso@2024Redis!
REDIS_DB=0
REDIS_URL=redis://:YaBiso@2024Redis!@redis:6379/0
REDIS_CACHE_EXPIRATION=3600
REDIS_SESSION_EXPIRATION=2592000

# ========== MESSAGE QUEUE (RabbitMQ) ==========
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=yabiso_user
RABBITMQ_PASSWORD=YaBiso@2024RabbitMQ!
RABBITMQ_VHOST=/yabiso
RABBITMQ_URL=amqp://yabiso_user:YaBiso@2024RabbitMQ!@rabbitmq:5672//yabiso
RABBITMQ_EXCHANGE=yabiso.events
RABBITMQ_QUEUE_PREFIX=yabiso.

# ========== PAIEMENTS - STRIPE ==========
STRIPE_PUBLIC_KEY=pk_test_your_public_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_API_VERSION=2024-01-01

# ========== PAIEMENTS - PAYPAL ==========
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_API_SIGNATURE=your_paypal_api_signature

# ========== PAIEMENTS - MOBILE MONEY ==========
ORANGE_MONEY_API_KEY=your_orange_money_api_key
ORANGE_MONEY_API_SECRET=your_orange_money_api_secret
ORANGE_MONEY_MERCHANT_ID=your_orange_money_merchant_id

VODACOM_API_KEY=your_vodacom_api_key
VODACOM_API_SECRET=your_vodacom_api_secret
VODACOM_MERCHANT_ID=your_vodacom_merchant_id

AIRTEL_API_KEY=your_airtel_api_key
AIRTEL_API_SECRET=your_airtel_api_secret
AIRTEL_MERCHANT_ID=your_airtel_merchant_id

EQUITY_API_KEY=your_equity_api_key
EQUITY_API_SECRET=your_equity_api_secret
EQUITY_MERCHANT_ID=your_equity_merchant_id

STANBIC_API_KEY=your_stanbic_api_key
STANBIC_API_SECRET=your_stanbic_api_secret
STANBIC_MERCHANT_ID=your_stanbic_merchant_id

# ========== EMAIL & NOTIFICATIONS ==========
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yabiso.cd
SENDGRID_FROM_NAME=YaBiso RDC

AWS_SES_REGION=eu-west-1
AWS_SES_FROM_EMAIL=noreply@yabiso.cd
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

SMTP_SERVER=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.your_sendgrid_api_key_here
EMAIL_ENABLE_HTML=True
EMAIL_RETRY_ATTEMPTS=3

# ========== STOCKAGE S3 (AWS) ==========
AWS_S3_REGION=eu-west-1
AWS_S3_BUCKET=yabiso-images
AWS_S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
AWS_S3_PUBLIC_URL=https://yabiso-images.s3.eu-west-1.amazonaws.com
AWS_S3_UPLOAD_DIR=uploads/
AWS_S3_MAX_FILE_SIZE=52428800

# ========== IMAGE OPTIMIZATION ==========
IMAGE_ENABLE_COMPRESSION=True
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080
IMAGE_QUALITY=85
IMAGE_SUPPORTED_FORMATS=jpg,jpeg,png,webp,gif

# ========== MONITORING & LOGGING ==========
SENTRY_DSN=https://your_sentry_key@sentry.io/your_project_id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key
DATADOG_SITE=datadoghq.com
DATADOG_ENV=development
DATADOG_SERVICE=yabiso-api

LOG_FILE_PATH=/var/log/yabiso/
LOG_FORMAT=json
ENABLE_STRUCTURED_LOGGING=True

# ========== GOOGLE OAUTH & SOCIAL ==========
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/auth/github/callback

FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:5173/auth/facebook/callback

# ========== FRONTEND ==========
FRONTEND_URL=http://localhost:5173
FRONTEND_BUILD_DIR=./dist
PORT=8000

# ========== SÉCURITÉ & CACHE ==========
ENABLE_REQUEST_SIGNING=True
ENABLE_AUDIT_LOG=True
CACHE_ENABLED=True
CACHE_DEFAULT_EXPIRATION=3600
ENABLE_QUERY_CACHING=True

# ========== WEBHOOKS ==========
WEBHOOK_TIMEOUT=30
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_SECRET_KEY=your_webhook_secret_key

# ========== API & VERSIONING ==========
API_VERSION=v1
API_TITLE=YaBiso API
API_DOCS_ENABLED=True

# ========== BACKGROUND JOBS ==========
CELERY_ENABLED=True
CELERY_BROKER_URL=amqp://yabiso_user:YaBiso@2024RabbitMQ!@rabbitmq:5672//yabiso
CELERY_RESULT_BACKEND=redis://:YaBiso@2024Redis!@redis:6379/1
CELERY_WORKER_CONCURRENCY=4

# ========== FILE UPLOAD ==========
UPLOAD_MAX_FILE_SIZE=52428800
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx,xls,xlsx,zip
UPLOAD_TEMP_DIR=/tmp/yabiso/uploads/
CLEANUP_TEMP_FILES_AFTER_HOURS=24

# ========== FEATURE FLAGS ==========
ENABLE_NEW_DASHBOARD=True
ENABLE_ANALYTICS=True
ENABLE_RECOMMENDATIONS=True
ENABLE_REAL_TIME_NOTIFICATIONS=True
ENABLE_ADVANCED_SEARCH=True

# ========== INTERNATIONALIZATION ==========
DEFAULT_LANGUAGE=fr
SUPPORTED_LANGUAGES=fr,en,sw,lg
ENABLE_AUTO_LANGUAGE_DETECTION=True
TIMEZONE=Africa/Kinshasa

# ========== CUSTOM SETTINGS ==========
COMPANY_NAME=YaBiso RDC
COMPANY_EMAIL=contact@yabiso.cd
COMPANY_PHONE=+243912345678
COMPANY_ADDRESS=Kinshasa, DRC

